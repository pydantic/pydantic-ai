        }
      ]
    },
    "expected": {
      "tool_definitions": [
        {
          "name": "search"
        }
      ]
    },
    "warnings": []
  },
  {
    "name": "an unknown top-level key costs nothing",
    "input": {
      "model": "openai:gpt-5.6-sol",
