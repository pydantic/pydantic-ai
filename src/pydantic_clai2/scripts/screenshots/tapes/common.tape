# Shared terminal: every screenshot has the same size, font, and colours.
Set Shell bash
Set FontFamily "JetBrains Mono"
Set FontSize 28
Set LineHeight 1.2
Set Width 2000
Set Height 1400
Set Padding 36
Set Margin 0
Set WindowBar Colorful
Set BorderRadius 14
Set Theme "Catppuccin Mocha"
Set TypingSpeed 10ms
Set WaitTimeout 90s
Set CursorBlink false
