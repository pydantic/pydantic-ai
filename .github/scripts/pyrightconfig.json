// Pyright skips every path under a dot directory, even one the root `[tool.pyright] include`
// names explicitly or one passed on its command line, so this directory is its own project.
// It inherits the root settings and virtual environment, whose out-of-band
// `pydantic-ai-harness` install matches the pin in `pydantic-ai-runner`.
// `make typecheck-pyright` runs it with `pyright -p .github/scripts`.
{
  "extends": "../../pyproject.toml",
  "include": ["."],
  "exclude": [
    // These tests deliberately exercise private helpers and loose GitHub webhook dictionaries
    // through monkeypatching; pytest covers them, while the module they test stays checked.
    "test_issue_pr_attention_monitor.py"
  ]
}
