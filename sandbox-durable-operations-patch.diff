+    exceeded = '[TMPRL1103] Attempted to upload payloads with size that exceeded the error limit'
+    if Version(version('temporalio')) >= Version('1.31'):
+        return exceeded
+    return f'{exceeded}. Size: {size} bytes, Limit: 2097152 bytes'
